# MediCore Environment Configuration Template
NODE_ENV=development
PORT=4002
HOST=0.0.0.0
API_PREFIX=/api/v1

# Security & Tokens
JWT_SECRET=medicore-dev-jwt-super-secret-key-change-in-prod-32bytesmin
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=12

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://medicore_user:medicore_secure_pass_2026@postgres:5432/medicore_db?schema=public
# For local host development without docker:
# DATABASE_URL=postgresql://medicore_user:medicore_secure_pass_2026@localhost:5432/medicore_db?schema=public

# Redis Cache & Sessions (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration
CORS_ORIGIN=http://localhost:3002

# Ports (Architecture Standard)
FRONTEND_PORT=3002
API_PORT=4002
ANALYTICS_PORT=8002
